{
  "name": "bitbook-desktop",
  "productName": "BitBook",
  "version": "0.1.0",
  "description": "Barebones desktop client for the BitBook distributed social network.",
  "main": "social-main.js",
  "scripts": {
    "start": "electron --no-sandbox .",
    "start:sandboxed": "electron .",
    "build": "node --check social-main.js && node --check social/core.js && node --check social/app.js && bash -n scripts/build-deb.sh",
    "package:linux": "bash scripts/build-deb.sh",
    "test": "npm run test:social",
    "test:social": "node test/socialCore.node.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larslarsen/bb-desktop.git"
  },
  "author": "BitBook contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/larslarsen/bb-desktop/issues"
  },
  "homepage": "https://github.com/larslarsen/bb-desktop#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.0.0"
  }
}
